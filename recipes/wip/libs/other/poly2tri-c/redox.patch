diff --git a/Makefile.am b/Makefile.am
index c6f694e..6082285 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -1,6 +1,6 @@
 SUBDIRS = poly2tri-c bin
 
-ACLOCAL_AMFLAGS = -I m4
